APP_ENV=development
APP_TIMEZONE=Europe/Istanbul
WEB_PORT=8000
POSTGRES_DB=gamerate
POSTGRES_USER=gamerate
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://gamerate:change-me@localhost:5432/gamerate
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
WORKER_ID=worker-1
WORKER_POLL_SECONDS=1
WORKER_STALE_SECONDS=30
RUN_STALE_SECONDS=900
SCHEDULE_INTERVAL_MINUTES=60
CRAWL_BATCH_SIZE=20
CRAWL_REQUEST_DELAY_SECONDS=0.6
CRAWL_CRITIC_REVIEW_PAGES=2
CRAWL_USER_REVIEWS_PER_PLATFORM=25
CRAWL_MAX_PLATFORMS=8
# Gemini enrichment. The key is environment-only and is never editable from /settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
GEMINI_REQUESTS_PER_MINUTE=25
AI_ENABLED=true
AI_MIN_REVIEWS=3
AI_MAX_GAMES_PER_RUN=20
AI_REFRESH_MIN_NEW_REVIEWS=5
AI_REFRESH_MIN_GROWTH=0.25
AI_MIN_REFRESH_INTERVAL_HOURS=12
# YouTube discovery and video analysis. Keys are environment-only and never editable in UI.
GOOGLE_CLOUD_API_KEY=
YOUTUBE_ANALYSIS_ENABLED=true
YOUTUBE_ANALYSIS_MODEL=gemini-3.5-flash
YOUTUBE_ANALYSIS_FRAGMENT_MINUTES=15
YOUTUBE_ANALYSIS_MAX_GAMES_PER_RUN=1
YOUTUBE_SEARCH_MAX_RESULTS=25
YOUTUBE_RETRY_INTERVAL_HOURS=24
YOUTUBE_NO_RESULT_REFRESH_DAYS=30
